<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Копировать данные"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:subtitle="Синхронизация между ТВ и смартфонами по Wi-Fi"
            app:subtitleTextAppearance="@style/TextAppearance.Material3.BodySmall"
            app:navigationIcon="@drawable/ic_arrow_back_24" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ВЫБОР РЕЖИМА: ИМПОРТ ИЛИ ЭКСПОРТ -->
            <LinearLayout
                android:id="@+id/layout_mode_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Выберите действие для этого устройства:"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOutline"
                    android:layout_marginBottom="12dp" />

                <!-- КАРТОЧКА 1: ИМПОРТ (ПРИЕМ ДАННЫХ ИЛИ УПРАВЛЕНИЕ НА ТВ) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_choose_import"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="?attr/colorPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.Material3.CardView.Filled"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:cardCornerRadius="16dp"
                                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                                app:cardElevation="0dp"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="📥"
                                    android:textSize="22sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Импорт (Получить данные)"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Идеально для Android TV и второго устройства"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOutline"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Открывает точку ожидания. Другой телефон в той же сети (или точке доступа) сможет обнаружить это устройство и в один клик перенести все профили, настройки и управлять режимами."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginTop="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_action_start_import"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Запустить режим Импорта"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            android:layout_marginTop="14dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- КАРТОЧКА 2: ЭКСПОРТ (ОТПРАВКА НАСТРОЕК С ТЕЛЕФОНА) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_choose_export"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.Material3.CardView.Filled"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:cardCornerRadius="16dp"
                                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                app:cardElevation="0dp"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="📤"
                                    android:textSize="22sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Экспорт (Передать данные)"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Отправить конфигурацию на ТВ или другой телефон"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOutline"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Сканирует локальную Wi-Fi сеть или подключенную точку доступа и ищет устройства, ожидающие импорт. После согласия передает всю базу и открывает пульт управления."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginTop="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_action_start_export"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Найти устройства для Экспорта"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            android:layout_marginTop="14dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ЭКРАН 2: АКТИВНЫЙ РЕЖИМ ИМПОРТА (ОЖИДАНИЕ КЛИЕНТА) -->
            <LinearLayout
                android:id="@+id/layout_import_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="?attr/colorPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center_horizontal">

                        <ProgressBar
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:indeterminate="true"
                            android:indeterminateTint="?attr/colorPrimary"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ожидание подключения..."
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tv_import_ip_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IP: 192.168.1.xxx • Порт: 19842"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"
                            android:fontFamily="monospace"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Откройте «Копировать данные» на телефоне и нажмите «Экспорт»"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOutline"
                            android:textAlignment="center"
                            android:layout_marginTop="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stop_import"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Завершить сеанс импорта"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            android:layout_marginTop="20dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ЭКРАН 3: АКТИВНЫЙ РЕЖИМ ЭКСПОРТА (ПОИСК И ПУЛЬТ УПРАВЛЕНИЯ) -->
            <LinearLayout
                android:id="@+id/layout_export_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- СПИСОК НАЙДЕННЫХ УСТРОЙСТВ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_export_devices"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Найденные устройства в сети:"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_discovered_devices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            tools:listitem="@layout/item_discovered_device" />

                        <ProgressBar
                            android:id="@+id/pb_scanning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginVertical="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_rescan_devices"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔄 Повторить поиск"
                            app:cornerRadius="14dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ПАНЕЛЬ УПРАВЛЕНИЯ ПОДКЛЮЧЕННЫМ УСТРОЙСТВОМ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_connected_remote"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="?attr/colorPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_remote_connected_device"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Подключено к: Android TV"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Сеанс подтвержден. Вы можете передать конфигурацию и управлять функциями."
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline"
                            android:layout_marginTop="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_send_all_data"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="📤 Перенести все настройки сейчас"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Удаленное управление на целевом устройстве:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="20dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_remote_toggle_byedpi"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ByeDPI"
                                app:cornerRadius="14dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_remote_toggle_warp"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="WARP"
                                app:cornerRadius="14dp"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_close_export_session"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Закрыть свой сеанс экспорта"
                            app:cornerRadius="14dp"
                            android:textColor="?attr/colorError"
                            app:strokeColor="?attr/colorError"
                            android:layout_marginTop="16dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
