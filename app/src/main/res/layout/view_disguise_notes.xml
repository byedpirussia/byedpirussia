<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Notes Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/notes_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/disguise_notes_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_notes_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:text="@string/disguise_notes_save"
            style="@style/Widget.Material3.Button.TonalButton" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Note Editor Area -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <EditText
                android:id="@+id/et_note_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top|start"
                android:padding="20dp"
                android:hint="@string/disguise_notes_hint"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:inputType="textMultiLine|textCapSentences" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Notes Footer Status -->
    <TextView
        android:id="@+id/tv_notes_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        android:gravity="center"
        android:text="Заметки сохраняются локально"
        android:textColor="?attr/colorOutline"
        android:textSize="12sp" />

</LinearLayout>
