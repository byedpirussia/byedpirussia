<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/warp_import_dialog_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/warp_import_dialog_msg"
            android:textSize="13sp"
            android:textColor="?attr/colorOutline"
            android:layout_marginBottom="16dp" />

        <!-- Быстрые действия: из буфера и выбор файла -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_from_clipboard"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/warp_import_from_clipboard"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_content_copy_24"
                app:iconSize="16dp"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_from_file"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/warp_import_from_file"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_file_upload_24"
                app:iconSize="16dp"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Поле ввода / просмотра конфигурации -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_warp_conf"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Конфигурация .conf ([Interface], [Peer])"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_warp_conf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="7"
                android:maxLines="14"
                android:gravity="top|start"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:inputType="textMultiLine|textNoSuggestions"
                android:scrollbars="vertical" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Подсказка о формате AmneziaWG -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Поддерживаются параметры обфускации AWG (Jc, Jmin, Jmax, H1..H4, S1..S4, I1)"
            android:textSize="11sp"
            android:textColor="?attr/colorOutline" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
