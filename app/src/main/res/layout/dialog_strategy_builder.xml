<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Заголовок и бейдж MD3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardElevation="0dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tune_24"
                    app:tint="?attr/colorOnSecondaryContainer"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Конструктор стратегий ByeDPI"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Интерактивная сборка и live-тестирование правил"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOutline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Preview карточка сгенерированной команды -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Генерируемые аргументы ядра:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOutline"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_preview_cmd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="-f-1 -t3 -n www.google.com -d1 -s2+s -a1 -S"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Быстрые шаблоны 2026 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Базовый шаблон для старта:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_tspu"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Анти-ТСПУ 2026"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_yt"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube 4K Fake" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_discord"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discord OOB" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_cascade"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Каскад 10 шагов" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Раздел 1: Fake & TTL -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_fake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Фейковый ClientHello (-f -1)"
                    android:textStyle="bold"
                    android:checked="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправляет ложный пакет перед настоящим для обмана фильтра ТСПУ"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOutline"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TTL фейкового пакета (-t):"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_ttl_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_ttl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="12"
                    android:stepSize="1"
                    android:value="3" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Фейковый SNI хост (-n)"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_fake_sni"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="www.google.com"
                        android:textSize="13sp"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Раздел 2: Split и Disorder -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Фрагментация и перестановка (Split / Disorder)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="10dp" />

                <!-- Split offset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Смещение Split (-s):"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_split_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2+s"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_split"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="15"
                    android:stepSize="1"
                    android:value="2" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_split_sni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Относительно позиции SNI (+s)"
                    android:checked="true" />

                <!-- Disorder offset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Смещение Disorder (-d):"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_disorder_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_disorder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="15"
                    android:stepSize="1"
                    android:value="1" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_disorder_sni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disorder относительно SNI (+s)"
                    android:checked="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Раздел 3: Модификаторы протоколов (TLSrec, OOB, SACK, UDP) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тонкие опции протоколов"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_tlsrec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Разделение TLS-записи (-r 1+s)"
                    android:checked="false" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_oob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Внедрение Out-Of-Band байта (-o 1)"
                    android:checked="false" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_sack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Сброс SACK (-S, обход ТСПУ 2026)"
                    android:checked="true" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_fake_udp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Фейковый UDP / QUIC (-a 1)"
                    android:checked="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Результат Live-теста -->
        <TextView
            android:id="@+id/tv_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Нажмите «Тестировать», чтобы проверить доступность YouTube и Discord"
            android:textSize="12sp"
            android:textColor="?attr/colorOutline"
            android:layout_marginBottom="14dp" />

        <!-- Кнопки действий -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_strategy"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Тест"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_strategy"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="✓ Применить" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
