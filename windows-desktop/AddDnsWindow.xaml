<Window x:Class="ByeDpiRussia.Desktop.AddDnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Добавление своего DNS"
        Height="280" Width="440"
        MinHeight="250" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="#F210131B"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="➕ Добавить собственный DNS сервер" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Укажите название и IPv4-адрес или домен вашего DNS-резолвера." FontSize="12" Foreground="#94A3B8"/>
        </StackPanel>

        <ui:SimpleStackPanel Grid.Row="1" Spacing="10">
            <TextBlock Text="Название (например, Мой AdGuard DNS):" FontSize="12" Foreground="#CBD5E1"/>
            <TextBox x:Name="TxtDnsName"/>

            <TextBlock Text="Адрес DNS сервера (IP или домен):" FontSize="12" Foreground="#CBD5E1"/>
            <TextBox x:Name="TxtDnsHost" Text="94.140.14.14"/>
        </ui:SimpleStackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Spacing="10">
            <Button x:Name="BtnCancel" Content="Отмена" Padding="14,6" Click="BtnCancel_Click"/>
            <Button x:Name="BtnAdd" Content="Добавить DNS" Style="{StaticResource AccentButtonStyle}" Padding="14,6" Click="BtnAdd_Click"/>
        </StackPanel>
    </Grid>
</Window>
