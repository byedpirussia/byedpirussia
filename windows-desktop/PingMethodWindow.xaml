<Window x:Class="ByeDpiRussia.Desktop.PingMethodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Выбор метода замера пинга"
        Height="310" Width="460"
        MinHeight="280" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="#F210131B"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚙️ Режим тестирования пинга серверов" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Выберите, каким способом измерять отклик узлов VLESS / Reality." FontSize="12" Foreground="#94A3B8"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="RbProxyGet" GroupName="PingMethod" Margin="0,4,0,8" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="🌐 Proxy GET (Настоящий пинг • Рекомендуется)" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8"/>
                    <TextBlock Text="Выполняет полный TLS Handshake с проверкой отклика пути." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbTcp" GroupName="PingMethod" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Text="⚡ TCP Connect" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC"/>
                    <TextBlock Text="Быстрое TCP-рукопожатие с портом сервера." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbIcmp" GroupName="PingMethod" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Text="📡 ICMP Echo" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC"/>
                    <TextBlock Text="Стандартный сетевой эхо-запрос к хосту с fallback на TCP 443." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Spacing="10">
            <Button x:Name="BtnCancel" Content="Отмена" Padding="14,6" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Padding="14,6" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
