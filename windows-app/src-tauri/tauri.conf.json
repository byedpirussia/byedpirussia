{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByeDPI Russia",
  "version": "1.1.5",
  "identifier": "com.byedpirussia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ByeDPI Russia",
        "width": 940,
        "height": 680,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": [
      "bin/*"
    ],
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
